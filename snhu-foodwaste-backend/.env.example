# Copy this file to .env in the same directory and fill in real values.
# Never commit .env to git.

# --- Required ---------------------------------------------------------------
# MongoDB connection string (Atlas or local). MONGO_URI is accepted as a legacy alias.
MONGODB_URI=mongodb://127.0.0.1:27017/snhu_foodwaste

# JWT signing secret. In production it must be 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret

# --- Optional ---------------------------------------------------------------
# Lets people register as staff when they enter this code. Leave empty to disable staff sign-up.
STAFF_SIGNUP_CODE=

# AI assistant: set ONE of these to enable the chat widget.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# API port (frontend is served from the same server in development)
PORT=5002

# --- Testing only -------------------------------------------------------------
# Real-database integration tests (local MongoDB only; a throwaway test_* database is used):
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017
